# Identify yourself to SEC/agencies (required by sec.gov; include a contact e-mail)
INTEL_UA="Degenscan Intel/0.1 (+https://degenscan.io; contact@degenscan.io)"

PORT=8787
DB_PATH=data/intel.db
UNIVERSE_PATH=data/universe.json
LOG_LEVEL=info

# --- Billing ---------------------------------------------------------------
# Free mode (default when X402_PAY_TO is unset). Set INTEL_FREE=0 with X402_PAY_TO to charge.
INTEL_FREE=1
FREE_DAILY_CALLS=100
# x402: USDC on Base. Facilitator default https://x402.org/facilitator (testnet); Base mainnet needs Coinbase CDP or own facilitator.
X402_PAY_TO=
X402_NETWORK=base
X402_FACILITATOR_URL=https://x402.org/facilitator
# API keys for Stripe subscribers (comma-separated)
API_KEYS=

# --- Optional keys (unlock more connectors later) ----------------------------
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
NASA_FIRMS_KEY=
ANTHROPIC_API_KEY=
EXPLAIN_LLM=0
