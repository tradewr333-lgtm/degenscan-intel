# Identify yourself to SEC/agencies (required by sec.gov; include a contact e-mail)
INTEL_UA="Degenscan Intel/0.1 (+https://degenscan.io; contact@degenscan.io)"

PORT=8787
DB_PATH=data/intel.db
# Production: persistent Render disk mounted at /data (track record, API keys and call history must survive redeploys)
INTEL_DB_PATH=
UNIVERSE_PATH=data/universe.json
LOG_LEVEL=info

# --- Billing ---------------------------------------------------------------
# Free mode (default when X402_PAY_TO is unset). Set INTEL_FREE=0 with X402_PAY_TO to charge.
INTEL_FREE=1
FREE_DAILY_CALLS=100
# x402: USDC on Base mainnet. PayAI facilitator settles on base without API keys (1,000 settlements/month free); x402.org is testnet-only.
X402_PAY_TO=
X402_NETWORK=base
X402_FACILITATOR_URL=https://facilitator.payai.network
# Legacy unlimited API keys (comma-separated). Subscriber keys live in the DB (see Stripe below).
API_KEYS=
PUBLIC_URL=https://intel.degenscan.io

# --- Stripe (fiat subscriptions → API keys) ----------------------------------
# Create two recurring Prices in Stripe (Starter $29/mo, Pro $199/mo) and paste their price_… ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Optional keys (unlock more connectors later) ----------------------------
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
NASA_FIRMS_KEY=
ANTHROPIC_API_KEY=
EXPLAIN_LLM=0

# Public metrics (/v1/metrics): launch date and owner/test wallets that must never count as customers
METRICS_SINCE=2026-09-27T00:00:00Z
EXCLUDED_WALLETS=0x5344722b8D037827A9a5b7cD6312481D215d33BF,0x21f4A2DA07bccE60878cAb223358D11aD8F11a94

# Optional second payment rail: Solana mainnet USDC (gasless via PayAI). Leave empty to accept Base only.
X402_PAY_TO_SOLANA=

# Optional: Coinbase CDP facilitator (enables listing in the Coinbase x402 Bazaar). Create at portal.cdp.coinbase.com.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Oracle (2Realidade forecasts inside Intel) ------------------------------
# DeepSeek is the default LLM (deepseek-chat for societies/panel, deepseek-reasoner for aggregation). ANTHROPIC_API_KEY above is the optional fallback.
DEEPSEEK_API_KEY=
# Shared secret for POST /v1/oracle/forecast/{id}/resolve (header X-OPERATOR-KEY). Generate a long random string.
ORACLE_OPERATOR_KEY=
# Parallel forecasts (DeepSeek rate limit) and daily board refresh (cron, UTC)
ORACLE_CONCURRENCY=2
ORACLE_BOARD_CRON=0 6 * * *
